# Copia este archivo como .env en el servidor. No subas .env al repositorio.
# La aplicación escucha solo en loopback: publica este puerto mediante Nginx,
# IIS, Caddy o el proxy HTTPS utilizado en el despliegue.
PORT=4174

# URL pública exacta, con HTTPS y sin barra final.
APP_ORIGIN=https://garaje.kaam.es

# Genera un valor aleatorio de 64 caracteres o más. No reutilices contraseñas.
SESSION_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
SESSION_COOKIE_SECURE=true

# PostgreSQL compartido con los workflows. Escapa los caracteres especiales de
# usuario y contraseña como exige una URL.
DATABASE_URL=postgresql://usuario:password@servidor:5432/ficharia
DATABASE_SSL=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# Los workflows actuales crean sus tablas en public. Garaje Kaam mantiene
# usuarios y sesiones en un esquema propio dentro de la misma base de datos.
FICHARIA_DATABASE_SCHEMA=public
KAAM_DATABASE_SCHEMA=garaje_kaam

# Bootstrap opcional: solo se aplica si no existe ningún usuario.
KAAM_INITIAL_ADMIN_EMAIL=alex.benito@kaam.es
KAAM_INITIAL_ADMIN_NAME=Alex Benito
KAAM_INITIAL_ADMIN_PASSWORD=

# Orígenes adicionales permitidos por connect-src de CSP, separados por comas.
# Mantener vacío mientras el navegador no se conecte directamente a servicios externos.
KAAM_CONNECT_ORIGINS=

# Integración futura con n8n. No usar el prefijo VITE_: son datos privados del servidor.
N8N_BASE_URL=
N8N_API_KEY=
# La URL completa tiene prioridad. Si queda vacía, se combina BASE_URL + PATH.
N8N_PROSPECTING_WEBHOOK_URL=
N8N_PROSPECTING_WEBHOOK_PATH=/webhook/ficharia/campanas
N8N_WEBHOOK_AUTH_TOKEN=
